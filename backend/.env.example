# Server
PORT=5000
NODE_ENV=development

# Database
# If MONGO_URI is left blank, the API automatically falls back to an
# in-memory data store seeded with realistic Maharashtra demo data.
# This lets the whole product run end-to-end with zero setup for a demo,
# while staying production-ready once a real MongoDB instance is attached.
MONGO_URI=mongodb://localhost:27017/citizenfirst_ai

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# AI service (Python FastAPI) — see /ai-service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_ENABLED=true

# CORS
FRONTEND_ORIGIN=http://localhost:5173
